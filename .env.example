# Copy to .env and fill in. Nothing here is required: without a key the built-in reader is used
# and every feature, including the booking form, still works.

# Optional. Lets Claude read plain-language room requests (cit/parser.py). Never used to decide anything.
ANTHROPIC_API_KEY=
# Optional. Model used for reading requests.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Port for the website (run.sh).
PORT=8000
# Optional. Where the app keeps its saved state (default var/state.json).
CIT_STATE=
